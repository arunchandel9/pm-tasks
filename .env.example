# Copy to .env.local for local dev; set the same keys in Vercel → Settings → Environment Variables.

# Database (Neon). Required.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Anthropic. Required. Model is one line to change.
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-5

# Slack app (from slack-manifest.yaml). One app, installed into every workspace via /api/slack/install.
# Tokens per workspace are stored in the database by the OAuth callback; SLACK_BOT_TOKEN is only a fallback.
SLACK_CLIENT_ID=...
SLACK_CLIENT_SECRET=...
SLACK_SIGNING_SECRET=...
SLACK_BOT_TOKEN=
STAFF_EMAIL_DOMAINS=mangoeyesagency.com
SLACK_REVIEW_CHANNEL=#pm-review
SLACK_INTAKE_CHANNEL=#intake
SLACK_P1_CHANNEL=#pm-review

# Pulp (our own board tool). Required for hour 4+. Endpoints are confirmed against the real API at hour 4.
PULP_BASE_URL=https://pulp.example.com/api
PULP_TOKEN=...

# Google: one service account (JSON, base64) for Sheets, Chat, Speech-to-Text, Drive.
GOOGLE_SERVICE_ACCOUNT_B64=
GOOGLE_PROJECT_NUMBER=
# Google Chat spaces (IDs from the space URL). PM Review = drafts, acks, alerts, summary. Intake = paste / voice notes / /task.
REVIEW_SURFACE=gchat
GCHAT_REVIEW_SPACE=
GCHAT_INTAKE_SPACE=
PM_SHEET_ID=1NXjvbfpJB36pb0BkkG08JEcUa35AxQ3PV5Nsj95I9-8
PM_SHEET_CONFIG_TAB=Config

# Cron protection: Vercel sends this header on cron invocations.
CRON_SECRET=change-me

# Kill switch. "true" pauses all intake; per-channel switches live in the settings table.
INTAKE_PAUSED=false
