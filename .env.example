# Copy to .env.local for local dev; set the same keys in Vercel → Settings → Environment Variables.

# Database (Neon). Required.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Anthropic. Required. Model is one line to change.
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-5

# Slack app (from slack-manifest.yaml). One app, installed into every workspace via /api/slack/install.
# Tokens per workspace are stored in the database by the OAuth callback; SLACK_BOT_TOKEN is only a fallback.
SLACK_CLIENT_ID=...
SLACK_CLIENT_SECRET=...
SLACK_SIGNING_SECRET=...
SLACK_BOT_TOKEN=
STAFF_EMAIL_DOMAINS=mangoeyesagency.com
# Exceptions: team members who use a non-MangoEyes address in a client workspace (comma-separated)
STAFF_EMAILS=
SLACK_REVIEW_CHANNEL=#pm-review
SLACK_INTAKE_CHANNEL=#intake
SLACK_P1_CHANNEL=#pm-review

# Pulp (our own board tool). API key from Pulp → Settings → API Keys (workspace admin). The key acts as one Pulp user,
# who must be a member of every department board. Base URL is derived from boards.yaml (https://pulp.mangoeyes.io/api/v1).
PULP_TOKEN=pulp_sk_...
# Only if the API lives somewhere else than <base_url>/api/v1
PULP_BASE_URL=

# Google: one service account (JSON, base64) for Sheets, Chat, Speech-to-Text, Drive.
GOOGLE_SERVICE_ACCOUNT_B64=
GOOGLE_PROJECT_NUMBER=
# Google Chat spaces (IDs from the space URL). PM Review = drafts, acks, alerts, summary. Intake = paste / voice notes / /task.
REVIEW_SURFACE=gchat
# notify (default): Staging in Pulp is the approval; PM Review gets one short line per task. approve: cards with buttons.
REVIEW_MODE=notify
GCHAT_REVIEW_SPACE=
GCHAT_INTAKE_SPACE=
# Only if the Chat app was configured with a different endpoint URL than the default below
GCHAT_ENDPOINT_URL=https://pm-tasks.vercel.app/api/gchat
PM_SHEET_ID=1NXjvbfpJB36pb0BkkG08JEcUa35AxQ3PV5Nsj95I9-8
# Long voice notes (> 1 min) are uploaded to this bucket for Google's long-running recognition. Created automatically
# as <project-id>-task-hub-voice in ASIA-SOUTH1 if the service account may create buckets; else create it by hand.
VOICE_BUCKET=
VOICE_BUCKET_LOCATION=ASIA-SOUTH1
PM_SHEET_CONFIG_TAB=Config

# Email intake: the hub reads one Workspace user's mailbox via domain-wide delegation (Gmail readonly + modify).
# GMAIL_MAILBOX must be a real user, not an alias. GMAIL_INTAKE_ADDRESS is the alias mails are sent to (filter).
GMAIL_MAILBOX=intake@mangoeyesagency.com
GMAIL_INTAKE_ADDRESS=intake@mangoeyesagency.com

# Cron protection: Vercel sends this header on cron invocations.
CRON_SECRET=change-me

# Optional: drop the raw Slack/Chat envelope of messages older than N days. 0 or unset = keep everything forever.
RAW_RETENTION_DAYS=0

# Kill switch. "true" pauses all intake; per-channel switches live in the settings table.
INTAKE_PAUSED=false
